<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="LifeManagement.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:LifeManagement.Views"
    Title="LifeManagement">

    <!-- Two tabs. The first one (Home) is the start page. -->
    <TabBar>
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate views:HomePage}"
            Route="HomePage" />

        <ShellContent
            Title="Todos"
            ContentTemplate="{DataTemplate views:TodoListPage}"
            Route="TodoListPage" />
    </TabBar>

</Shell>

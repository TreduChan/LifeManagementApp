<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:LifeManagement"
             xmlns:converters="clr-namespace:LifeManagement.Converters"
             x:Class="LifeManagement.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- App-wide converter: any page can use it with {StaticResource PriorityToColor} -->
            <converters:PriorityToColorConverter x:Key="PriorityToColor" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LifeManagement.MainPage"
             Title="Add task">

    <!-- 2 equal columns, 7 rows: only the notes row (2) stretches -->
    <Grid Padding="20"
          RowSpacing="12"
          ColumnSpacing="12"
          ColumnDefinitions="*,*"
          RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">

        <!-- Row 0: heading, follows light/dark theme -->
        <Label Grid.Row="0" Grid.ColumnSpan="2"
               Text="New task"
               Style="{StaticResource Headline}"
               TextColor="{AppThemeBinding Light=#241A45, Dark=White}" />

        <!-- Row 1: title -->
        <Entry Grid.Row="1" Grid.ColumnSpan="2"
               x:Name="TitleEntry"
               Placeholder="Title" />

        <!-- Row 2: notes (the stretching row) -->
        <Editor Grid.Row="2" Grid.ColumnSpan="2"
                x:Name="NotesEditor"
                Placeholder="Notes" />

        <!-- Row 3: category + due date -->
        <Picker Grid.Row="3" Grid.Column="0"
                x:Name="CategoryPicker"
                Title="Category" />

        <DatePicker Grid.Row="3" Grid.Column="1"
                    x:Name="DueDatePicker"
                    Format="dd.MM.yyyy" />

        <!-- Row 4: reminder switch + priority stepper -->
        <HorizontalStackLayout Grid.Row="4" Grid.Column="0" Spacing="8">
            <Label Text="Reminder" VerticalOptions="Center" />
            <Switch x:Name="ReminderSwitch" IsToggled="True" />
        </HorizontalStackLayout>

        <HorizontalStackLayout Grid.Row="4" Grid.Column="1" Spacing="8">
            <Label Text="Priority" VerticalOptions="Center" />
            <Label x:Name="PriorityLabel" Text="3" VerticalOptions="Center" />
            <Stepper x:Name="PriorityStepper"
                     Minimum="1" Maximum="5" Value="3" Increment="1"
                     ValueChanged="OnPriorityChanged" />
        </HorizontalStackLayout>

        <!-- Row 5: save -->
        <Button Grid.Row="5" Grid.ColumnSpan="2"
                Text="Save"
                Clicked="OnSaveClicked" />

        <!-- Row 6: result message + saved task cards (newest on top) -->
        <VerticalStackLayout Grid.Row="6" Grid.ColumnSpan="2" Spacing="8">
            <Label x:Name="ResultLabel" Text="" />
            <ScrollView>
                <VerticalStackLayout x:Name="SavedList" Spacing="8" />
            </ScrollView>
        </VerticalStackLayout>

    </Grid>

</ContentPage>

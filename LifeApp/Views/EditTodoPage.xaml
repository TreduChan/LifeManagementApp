<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LifeManagement.ViewModels"
             x:Class="LifeManagement.Views.EditTodoPage"
             x:DataType="vm:EditTodoViewModel"
             Title="Edit todo">

    <!-- Rows: title, notes (stretches), due date + done, priority, buttons -->
    <Grid Padding="20" RowSpacing="12" ColumnSpacing="12"
          ColumnDefinitions="*,*"
          RowDefinitions="Auto,*,Auto,Auto,Auto">

        <Entry Grid.Row="0" Grid.ColumnSpan="2"
               Placeholder="Title"
               Text="{Binding Title}" />

        <Editor Grid.Row="1" Grid.ColumnSpan="2"
                Placeholder="Notes"
                Text="{Binding Notes}" />

        <DatePicker Grid.Row="2" Grid.Column="0"
                    Format="dd.MM.yyyy"
                    Date="{Binding DueDate}" />

        <HorizontalStackLayout Grid.Row="2" Grid.Column="1" Spacing="8">
            <CheckBox IsChecked="{Binding IsDone}" />
            <Label Text="Done" VerticalOptions="Center" />
        </HorizontalStackLayout>

        <HorizontalStackLayout Grid.Row="3" Grid.ColumnSpan="2" Spacing="8">
            <Label VerticalOptions="Center"
                   Text="{Binding Priority, StringFormat='Priority {0}'}" />
            <Stepper Minimum="1" Maximum="5" Increment="1"
                     Value="{Binding Priority}" />
        </HorizontalStackLayout>

        <Button Grid.Row="4" Grid.Column="0"
                Text="Save"
                Command="{Binding SaveCommand}" />

        <Button Grid.Row="4" Grid.Column="1"
                Text="Delete"
                BackgroundColor="Red" TextColor="White"
                Command="{Binding DeleteCommand}" />

    </Grid>

</ContentPage>

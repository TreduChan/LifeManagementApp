<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LifeManagement.ViewModels"
             xmlns:models="clr-namespace:LifeManagement.Models"
             x:Class="LifeManagement.Views.HomePage"
             x:DataType="vm:HomeViewModel"
             Title="Home">

    <!-- Rows: weather heading, weather text, kitesurf notice, todos heading, top 3 list -->
    <Grid Padding="20" RowSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto,*">

        <Label Grid.Row="0" Text="Weather" Style="{StaticResource SubHeadline}" HorizontalOptions="Start" />

        <!-- Spinner + text side by side. The spinner only shows while the weather is loading. -->
        <HorizontalStackLayout Grid.Row="1" Spacing="8">
            <ActivityIndicator IsRunning="{Binding IsLoadingWeather}"
                               IsVisible="{Binding IsLoadingWeather}"
                               HeightRequest="20" WidthRequest="20" />
            <Label Text="{Binding WeatherText}" FontSize="16" VerticalOptions="Center" />
        </HorizontalStackLayout>

        <!-- Only visible when the ViewModel says wind > 5 m/s -->
        <Border Grid.Row="2" Padding="12" StrokeShape="RoundRectangle 8"
                BackgroundColor="{StaticResource Primary}"
                IsVisible="{Binding IsKitesurfWeather}">
            <Label Text="🪁 Kitesurf-keli!" TextColor="White" FontSize="20" FontAttributes="Bold" />
        </Border>

        <Label Grid.Row="3" Text="Top 3 todos" Style="{StaticResource SubHeadline}" HorizontalOptions="Start" />

        <CollectionView Grid.Row="4"
                        ItemsSource="{Binding TopTodos}"
                        EmptyView="Nothing to do. Add todos on the Todos tab.">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:TodoItem">
                    <Border Padding="12" Margin="0,0,0,8" StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="16" />
                            <HorizontalStackLayout Spacing="12">
                                <Label Text="{Binding Priority, StringFormat='Priority {0}'}"
                                       TextColor="{Binding Priority, Converter={StaticResource PriorityToColor}}" />
                                <Label Text="{Binding DueDate, StringFormat='Due {0:dd.MM.yyyy}'}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
